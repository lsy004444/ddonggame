--- !u!114 &73591531
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 73591529}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<\uB625 \uBAA8\uC544 \uD0DC\uC0B0> \uAC8C\uC784 \uBC29\uBC95 \r\n \r\n
    1. \uB5A8\uC5B4\uC9C0\uB294 \uB625 \uC218\uC9D1\uD558\uAE30!\r\n* \uBC29\uD5A5\uD0A4
    \uD074\uB9AD \uD639\uC740 \uD654\uBA74\uC744 \uC88C\uC6B0\uB85C \uD130\uCE58\uD558\uC5EC
    \uC704\uC5D0\uC11C \uB5A8\uC5B4\uC9C0\uB294 \uB2E4\uC591\uD55C \uB625\uC744 \uBC14\uAD6C\uB2C8\uC5D0
    \uB2F4\uC73C\uC138\uC694.\r\n* \uB9CE\uC774 \uBAA8\uC744\uC218\uB85D \uBC2D\uC5D0
    \uC2EC\uC744 \uC218 \uC788\uB294 \uAE30\uD68C\uAC00 \uB298\uC5B4\uB098\uC694! 
    \r\n 2. \uBC2D\uC5D0 \uC2EC\uACE0 \uC791\uBB3C \uD0A4\uC6B0\uAE30!\r\n* \uBAA8\uC544\uC628
    \uB625\uC744 \uD648 \uD654\uBA74\uC758 \uBE48 \uBC2D \uCE78\uC5D0 \uC2EC\uC5B4\uC8FC\uC138\uC694.\r\n*
    \uBCBC, \uD1A0\uB9C8\uD1A0, \uADF8\uB9AC\uACE0 \uD76C\uADC0\uD55C \uC950\uB625\uACE0\uCD94\uAE4C\uC9C0
    \uB79C\uB364\uD558\uAC8C \uC791\uBB3C\uC774 \uC790\uB77C\uB0A9\uB2C8\uB2E4! 
    \r\n 3. \uC218\uD655\uD574\uC11C \uB300\uBC15 \uBD80\uC790 \uB418\uAE30!\r\n*
    \uB2E4 \uC790\uB780 \uC791\uBB3C\uC744 \uD130\uCE58\uD574 \uC218\uD655\uD558\uBA74
    \uD654\uD3D0\uC778 '\uB625\uD30C\uB9AC'\uB97C \uD68D\uB4DD\uD569\uB2C8\uB2E4.\r\n\r\n\uC81C\uD55C
    \uC2DC\uAC04 6\uBD84! \uCD5C\uACE0\uC758 \uC810\uC218\uB97C \uAC31\uC2E0\uD558\uACE0
    \uBAA8\uB4E0 \uB625\uACFC \uC791\uBB3C \uCEEC\uB809\uC158\uC744 \uC644\uC131\uD574
    \uBCF4\uC138\uC694!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 15731e1c771cb28478393fa900c18afd, type: 2}
  m_sharedMaterial: {fileID: 2805995826882780373, guid: 15731e1c771cb28478393fa900c18afd, type: 2}
